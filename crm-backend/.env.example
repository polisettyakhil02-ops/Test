# Copy to .env and adjust for your deployment.

# Port the server listens on.
PORT=4000

# MongoDB connection string. Local dev: mongodb://127.0.0.1:27017/dominare_crm
# Hosted: an Atlas (or similar) connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/dominare_crm

# Secret used to sign JWTs. Set this to a long random value in any real
# deployment - the default below is only for local dev.
JWT_SECRET=dev-secret-change-me
# How long an issued token stays valid (jsonwebtoken "expiresIn" format).
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API (your frontend's
# URL(s)). Defaults to "*" (any origin), which is fine for local development
# but should be locked down before deploying for real.
CORS_ORIGIN=*

# Where uploaded file attachments are written (src/lib/storage.js). Defaults
# to ./uploads. Point this at a persistent volume/disk on platforms with an
# ephemeral filesystem, same caveat as backend/'s JSON store - see "Moving to
# a real database" below for the same reasoning applied to file storage.
UPLOAD_DIR=./uploads

# --- Seed script (src/data/seed.js) -----------------------------------------
# Credentials for the admin account the seed script creates. Change these
# before running the seed against anything but a throwaway local database.
SEED_ADMIN_EMAIL=admin@dominaretech.com
SEED_ADMIN_PASSWORD=changeme123
