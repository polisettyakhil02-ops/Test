# Where the API lives. Leave unset in development — Vite proxies /api to the
# backend so the browser stays on one origin.
#
# In production, set this at BUILD time (Vite inlines it) to the public URL of
# your API, e.g. https://api.yourco.com. If the API is behind the same reverse
# proxy under /api, leave it empty.
VITE_API_URL=
