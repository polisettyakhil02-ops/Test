# Copy to .env for local development.

# --- Database ---
# A MongoDB Atlas connection string (mongodb+srv://...) is what production
# should point at — it is already a replica set, which multi-document
# transactions require. For local work without Atlas, `npm run dev:db` runs a
# real single-node replica set on your machine and prints the URI to use here.
MONGODB_URI=mongodb://127.0.0.1:27017/billing?replicaSet=rs0
DATABASE_POOL_MAX=10

# --- Sessions ---
# Signs the session token. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
JWT_SECRET=replace-me-with-a-long-random-string
SESSION_MAX_AGE_SECONDS=43200

# --- CORS ---
# Comma-separated origins the browser app is served from. The API is on a
# different origin by design, so this is not optional — an empty list means no
# browser can talk to it. Never use '*': it cannot be combined with credentials.
CORS_ORIGINS=http://localhost:5173

# Set to true when the API and the front end are on different *sites*, not just
# different ports. The session cookie then needs SameSite=None, which browsers
# only accept over HTTPS.
COOKIE_CROSS_SITE=false

PORT=4000

# --- Outbound events (optional) ---
# WEBHOOK_ENDPOINT=https://your-service.example.com/hooks/billing
# WEBHOOK_SECRET=replace-me-with-a-long-random-string
# OUTBOX_INTERVAL_MS=5000
