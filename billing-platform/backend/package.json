{
  "name": "billing-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API and double-entry ledger for the billing system",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && npm run build:server && npm run build:scripts",
    "build:server": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist/index.js",
    "build:scripts": "esbuild src/scripts/migrate.ts src/scripts/setup.ts src/scripts/entity.ts src/scripts/demo-seed.ts src/scripts/outbox-worker.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist/scripts",
    "start": "node dist/index.js",
    "migrate": "tsx src/scripts/migrate.ts",
    "setup": "tsx src/scripts/setup.ts",
    "entity": "tsx src/scripts/entity.ts",
    "demo": "tsx src/scripts/demo-seed.ts",
    "outbox": "tsx src/scripts/outbox-worker.ts",
    "dev:db": "tsx src/scripts/dev-db.mts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.6.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.20.0",
    "mongodb-memory-server": "^11.2.0",
    "react": "19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
