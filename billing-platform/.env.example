# Copy to .env before `docker compose up`. Compose reads this file; the
# per-service settings in docker-compose.yml are built from it.
#
# The two marked REQUIRED have no default on purpose — Compose refuses to start
# without them rather than booting with a guessable secret.

# --- Database ---
POSTGRES_USER=billing
POSTGRES_DB=billing
# REQUIRED. Nothing outside the Compose network can reach PostgreSQL, but this
# is still the password on your books.
POSTGRES_PASSWORD=

# Below the database's connection limit. 10 is fine for one backend instance.
DATABASE_POOL_MAX=10

# --- Sessions ---
# REQUIRED. Signs the session token. Generate one with:
#   openssl rand -base64 48
# Changing it signs everyone out, which is also how you revoke every session.
JWT_SECRET=

# 43200 = 12 hours.
SESSION_MAX_AGE_SECONDS=43200

# --- Serving ---
# The port the browser app is published on.
HTTP_PORT=8080

# Only matters if the browser talks to the API directly instead of through
# nginx. Comma-separated, exact origins, no trailing slash, never '*'.
CORS_ORIGINS=http://localhost:8080

# Set to true only when the browser app and the API are on different *sites*
# (say, a GitHub Pages front end and an API on your own domain). The session
# cookie then needs SameSite=None, which browsers only accept over HTTPS.
COOKIE_CROSS_SITE=false

# --- Outbound events (optional) ---
# Posting or voiding a document queues an event. The worker delivers it with an
# HMAC-SHA256 signature over the request body. Leave blank to keep events
# queued and deliver nothing.
WEBHOOK_ENDPOINT=
WEBHOOK_SECRET=
OUTBOX_INTERVAL_MS=5000
