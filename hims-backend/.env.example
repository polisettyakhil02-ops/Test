NODE_ENV=development
PORT=4000

# MongoDB replica set is mandatory (multi-document transactions require it)
MONGODB_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/hims?replicaSet=rs0

REDIS_URL=redis://redis:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-48-byte-base64-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-48-byte-base64-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

COOKIE_SECRET=replace-with-a-random-48-byte-base64-secret
CORS_ORIGIN=http://localhost:5173

UHID_PREFIX=HIMS
AUDIT_LOG_RETENTION_DAYS=2555
