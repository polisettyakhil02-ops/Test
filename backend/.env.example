# Copy to .env and adjust for your deployment. All of these have sane
# defaults, so a bare `npm start` works with none of this set.

# Port the server listens on.
PORT=3000

# Where the JSON store (data/store.json) and audit log (data/audit.log) are
# written. Defaults to ./data. Point this at a persistent volume/disk on
# platforms with an ephemeral filesystem (see README "Hosting").
DATA_DIR=./data

# Set to any non-empty value when running behind a reverse proxy / load
# balancer (Render, Railway, Heroku, Nginx, ...) so req.ip reflects the real
# client instead of the proxy - needed for the rate limiter to work per-user
# rather than per-proxy.
TRUST_PROXY=1

# Comma-separated list of origins allowed to call this API (your frontend's
# URL(s)). Defaults to "*" (any origin), which is fine for local development
# but should be locked down before deploying - see README "Before exposing
# this to real users".
CORS_ORIGIN=*

# --- LLM-backed intent parsing (optional) -----------------------------------
# Unset/default: query parsing uses the built-in rule-based parser (free, no
# API key, no network call). Set INTENT_ENGINE=llm to route parsing through
# Claude instead - see README "LLM-backed parsing". Any failure here (missing
# key, network error, timeout) automatically falls back to the rule-based
# parser, so this is safe to enable without a fallback plan.
INTENT_ENGINE=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
