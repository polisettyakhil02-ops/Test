# Copy to .env.local and fill in.

# --- MongoDB ---
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=billing

# --- NextAuth (Auth.js v5) ---
# Generate with:  npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Required in production so Auth.js builds correct callback URLs.
# Leave unset in local development.
# AUTH_URL=https://billing.yourcompany.com

# --- App ---
# Prefix for generated invoice numbers, e.g. INV-00001
INVOICE_PREFIX=INV

# --- Your company details (the "from" side of every invoice PDF) ---
COMPANY_NAME=Your Company Pvt Ltd
# Address lines separated by "|"
COMPANY_ADDRESS=12 MG Road|Bengaluru, Karnataka 560001|India
COMPANY_GSTIN=29ABCDE1234F1Z5
COMPANY_EMAIL=accounts@yourcompany.com
COMPANY_PHONE=+91 98765 43210
COMPANY_WEBSITE=https://yourcompany.com
COMPANY_BANK_DETAILS=Bank: HDFC Bank | A/C: 000111222333 | IFSC: HDFC0000123
COMPANY_FOOTER=This is a computer-generated invoice.
