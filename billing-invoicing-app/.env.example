# Copy to .env.local for local development, or to .env for docker compose.

# --- MongoDB ---
# A replica set is required -- this application posts every document inside a
# multi-document transaction, and MongoDB refuses transactions outright on a
# standalone server. Atlas clusters already are one.
# Local:  mongodb://127.0.0.1:27017/billing?replicaSet=rs0  (npm run dev:db prints this)
# Atlas:  mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/billing?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/billing?replicaSet=rs0
DATABASE_POOL_MAX=10

# --- Auth (Auth.js v5) ---
# Generate with:  npx auth secret
# Changing it signs everyone out. Keep it out of version control.
AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Required in production so Auth.js builds correct callback URLs. Must be the
# public https:// URL your users type, not the container's address.
# AUTH_URL=https://billing.yourcompany.com

# Set when the app runs behind a reverse proxy, so Auth.js trusts the
# X-Forwarded-* headers the proxy sets. docker compose sets it for you.
# AUTH_TRUST_HOST=true

# --- Outbound events (optional) ---
# Posting an invoice, credit note or payment queues an event. The outbox worker
# delivers them here, signed as `t=<unix>,v1=<hmac-sha256 of "<t>.<body>">` in
# X-Billing-Signature. Both values are required before anything is delivered --
# an unsigned webhook is one the receiver cannot safely act on. Leave them unset
# and events simply queue; nothing is lost.
# WEBHOOK_ENDPOINT=https://your-service.example.com/hooks/billing
# WEBHOOK_SECRET=replace-me-with-a-long-random-string
# OUTBOX_INTERVAL_MS=5000
