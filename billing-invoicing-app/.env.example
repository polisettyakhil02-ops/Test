# Copy to .env.local and fill in.

# --- PostgreSQL ---
# Local:  postgres://postgres:postgres@localhost:5432/billing
# Hosted: postgres://user:pass@host:5432/billing?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/billing
DATABASE_POOL_MAX=10

# --- Auth (Auth.js v5) ---
# Generate with:  npx auth secret
AUTH_SECRET=replace-me-with-a-32-byte-random-string

# Required in production so Auth.js builds correct callback URLs.
# AUTH_URL=https://billing.yourcompany.com
