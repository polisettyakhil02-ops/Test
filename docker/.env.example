# Copy to docker/.env ("cp .env.example .env" from this directory) and
# fill in every value below — docker-compose.prod.yml auto-loads .env from
# its own directory for ${VAR} interpolation. Never commit the real .env.
# Full walkthrough, including exactly how to generate each secret: ../DEPLOYMENT.md

# ---- MongoDB replica set --------------------------------------------------
MONGO_REPLICA_SET_NAME=rs0

# Host path to the keyfile used for internal cluster authentication between
# mongo1/2/3. Generate it and lock down its permissions BEFORE first `up`:
#   openssl rand -base64 756 > docker/secrets/mongo-keyfile
#   chmod 400 docker/secrets/mongo-keyfile
#   sudo chown 999:999 docker/secrets/mongo-keyfile   # 999 = the mongo:7.0 image's internal "mongodb" uid/gid
MONGO_KEYFILE_PATH=./secrets/mongo-keyfile

# Cluster admin (root role on the admin db). Used only by mongo-setup to
# bootstrap the replica set and the scoped application user below — the API
# never authenticates as this user. Generate a password with:
#   openssl rand -base64 24
MONGO_INITDB_ROOT_USERNAME=hims_root
MONGO_INITDB_ROOT_PASSWORD=

# Scoped application user (readWrite on MONGO_APP_DATABASE only — not root).
# This is what hims-backend actually connects as.
MONGO_APP_USERNAME=hims_app
MONGO_APP_PASSWORD=
MONGO_APP_DATABASE=hims

# ---- Redis -----------------------------------------------------------------
# openssl rand -base64 24
REDIS_PASSWORD=

# ---- hims-backend (see hims-backend/src/config/env.ts for what each does) -
# openssl rand -base64 48   (run twice — these two MUST be different)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Optional — the mobile gateway's own token secret (Step 16). Falls back to
# JWT_ACCESS_SECRET when unset; set separately in production to rotate the
# Patient/Doctor apps' tokens independently of the web SPA's.
# openssl rand -base64 48
JWT_MOBILE_ACCESS_SECRET=
JWT_MOBILE_ACCESS_TTL_SECONDS=600

# openssl rand -base64 48
COOKIE_SECRET=

# Your public site origin, no trailing slash — must match what's served
# behind nginx-proxy, since it's used for CORS + cookie scoping.
CORS_ORIGIN=https://yourdomain.com

UHID_PREFIX=HIMS
AUDIT_LOG_RETENTION_DAYS=2555

# ---- hims-frontend build ----------------------------------------------------
# /api works as-is because nginx-proxy serves the frontend and proxies /api
# on the SAME origin — only change this if the API is ever split to a
# different origin.
VITE_API_BASE_URL=/api

# ---- Image tagging (optional) ----------------------------------------------
IMAGE_TAG=latest

# ---- Referenced by the deployment commands in ../DEPLOYMENT.md, not by
# ---- compose interpolation directly (docker/nginx/default.conf's server_name
# ---- and the certbot -d flag are literal, per that guide's sed step) -------
DOMAIN_NAME=yourdomain.com
CERTBOT_EMAIL=admin@yourdomain.com
